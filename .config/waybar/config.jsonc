{
    "reload_style_on_change": true,
    "layer": "top",
    "position": "top",
    "mod": "dock",
    "margin-top": 3,
    "height": 24,
    "margin-left": 5,
    "margin-right": 5,
    "margin-bottom": 0,

    "group/left1": {
        "orientation": "inherit",
        "modules": [ "clock"]
    },

    "group/left2": {
        "orientation": "inherit",
        "modules": ["hyprland/workspaces"]
    },
    "group/left3": {
        "orientation": "inherit",
        "modules": [
            "idle_inhibitor",
        ]
    },
    "modules-left": [
        "group/left1",
        "group/left2",
        "group/left3",
    ],
    "modules-center": ["hyprland/window"],
    "modules-right": ["group/right1", "group/right2"],

    "group/right1": {
        "orientation": "inherit",
        "modules": ["tray"]
    },
    "group/right2": {
        "orientation": "inherit",
        "modules": [
            "backlight",
            "bluetooth",
            "pulseaudio#output",
            "network",
            "memory",
            "cpu",
            "battery"
        ]
    },
    "include": [
        "./modules/workspaces.jsonc"
    ],

    "cpu": {
        "interval": 2,
        "format": "{usage}% 󰍛",
        "on-click": ""
    },

    "memory": {
        "interval": 2,
        "format": "  {percentage}%",
        "on-click": ""
    },

    "clock": {
        "format": " {:%H:%M %a} ",
        "format-alt": " {:%d/%m/%Y  %H:%M:%S}",
        "tooltip-format": "<span>{calendar}</span>",
        "calendar": {
            "mode": "month",
            "weeks-pos": "right",
            "mode-mon-col": 3,
            "on-click-right": "mode",
            "format": {
                "month": "<span color='#ffead3'><b>{}</b></span>",
                "weekdays": "<span color='#ffcc66'><b>{}</b></span>",
                "today": "<span color='#ff6699'><b>{}</b></span>"
            }
        },
        "on-click-right": ""
    },

    "idle_inhibitor": {
        "format": "{icon}",
        "format-icons": {
            "activated": "󰛊",
            "deactivated": "󰾫"
        }
    },

    "network": {
        "format-wifi": "{icon}",
        "format-ethernet": "",
        "format-linked": "󱘖",
        "format-disconnected": "󰤣",
        "format-disabled": "󰤮",
        "format-icons": [
            "󰤯",
            "󰤟",
            "󰤢",
            "󰤥",
            "󰤨"
        ],
        "tooltip-format-disconnected": "No Connection",
        "tooltip-format-disabled": "Wi-Fi is OFF",
        "tooltip-format-wifi": "󱄙  {essid} ({signalStrength}%)\n\n󰐻  Freq: {frequency}GHz\n  {bandwidthDownBytes}   {bandwidthUpBytes}",
        "tooltip-format-ethernet": "󰈀  {ifname} (Connected)\n  {bandwidthDownBytes}   {bandwidthUpBytes}",
        "tooltip-format-linked": "󱘖 {ifname}: No IP Address",
        "on-click": "hyprctl eval \"hl.exec_cmd('nm-connection-editor')\""  
    },

        "battery": {
            "format": "{capacity}% {icon}",
            "format-discharging": "{capacity}% {icon}",
            "format-charging": "{icon}",
            "format-plugged": "",
            "format-icons": {
            "charging": [
                "󰢜",
                "󰂆",
                "󰂇",
                "󰂈",
                "󰢝",
                "󰂉",
                "󰢞",
                "󰂊",
                "󰂋",
                "󰂅"
            ],
            "default": [
                "󰁺",
                "󰁻",
                "󰁼",
                "󰁽",
                "󰁾",
                "󰁿",
                "󰂀",
                "󰂁",
                "󰂂",
                "󰁹"
            ]
        },
        "format-full": "󰂅",
        "tooltip-format-discharging": "{timeTo}",
        "tooltip-format-charging": "{timeTo}",
        "interval": 5,
        "on-click": "",
        "on-click-right": "",
        "states": {
            "warning": 20,
            "critical": 10
        }
    },

    "bluetooth": {
        "format": "",
        "format-disabled": "󰂲",
        "format-off": "󰂲",
        "format-connected": "󰂱",
        "tooltip-format": "Devices connected: {num_connections}",
        "on-click": "blueman-manager"
    },

    "pulseaudio#output": {
        "format": "{icon}",
        "tooltip-format": "{icon}  {volume}%",
        "format-muted": "",
        "format-icons": {
            "default": [""]
        },
        "max-volume": 100,
        "scroll-step": 5,
        "smooth-scrolling-threshold": 1,
        "on-click": "pavucontrol",
        "on-click-right": ""
    },
    "tray": {
        "icon-size": 20,
        "spacing": 10,
    }
}
