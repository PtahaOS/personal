#!/usr/bin/env zsh

## hyprland
echo "\nhyprland"
rsync -a --delete $HOME/personal/.config/hypr/ $HOME/.config/hypr/
ls -a $HOME/.config/hypr/
hyprctl reload

## wezterm
echo "\nwezterm"
rsync -a --delete $HOME/personal/.config/wezterm/ $HOME/.config/wezterm/
ls -a $HOME/.config/wezterm/

## zsh
echo "\nzsh"
CUSTOM="$HOME/.oh-my-zsh/custom/aliases.zsh"
rsync -a --delete $HOME/personal/.config/zsh/aliases.zsh "$CUSTOM"
rsync -a --delete $HOME/personal/.config/zsh/.zshrc "$HOME/.zshrc"
source $HOME/.zshrc
#ls -a $ZSH_CUSTOM/
tail "$CUSTOM"

## keyd
