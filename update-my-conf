#sudo rsync -a --delete $HOME/personal/.config/keyd/default.conf /etc/keyd/default.conf
#sudo systemctl enable --now keyd
#sudo keyd reload
#tail "/etc/keyd/default.conf"

## waybar
echo "\nwaybar"
rsync -a --delete $HOME/personal/.config/waybar/ $HOME/.config/waybar/
pkill waybar
hyprctl dispatch "hl.dsp.exec_cmd('waybar')"

## rofi
echo "\nrofi"
rsync -a --delete $HOME/personal/.config/rofi/ $HOME/.config/rofi/

## tmux
echo "\ntmux"
rsync -a --delete $HOME/personal/.config/tmux/tmux.conf $HOME/.config/tmux/tmux.conf
tmux source-file $HOME/.config/tmux/tmux.conf

## swaync
echo "\nswaync"
rsync -a --delete $HOME/personal/.config/swaync/ $HOME/.config/swaync/
pkill swaync
hyprctl dispatch "hl.dsp.exec_cmd('swaync')"
