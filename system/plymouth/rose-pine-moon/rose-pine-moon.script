// Rose Pine Moon. Только конструкции, которые Plymouth уже умеет в чужих темах.
screen.w = Window.GetWidth(0);
screen.h = Window.GetHeight(0);
screen.half.w = screen.w / 2;
screen.half.h = screen.h / 2;

Window.SetBackgroundTopColor(0.137, 0.129, 0.212);
Window.SetBackgroundBottomColor(0.137, 0.129, 0.212);

title.image = Image.Text("rose pine", 0.769, 0.655, 0.906);
title.sprite = Sprite(title.image);
title.sprite.SetX(screen.half.w - title.image.GetWidth() / 2);
title.sprite.SetY(screen.half.h - 40);

bullets = null;
bullet.image = Image.Text("*", 0.769, 0.655, 0.906);
prompt_done = 0;

fun DisplayPasswordCallback(nil, bulletCount) {
    if (prompt_done == 0) {
        label.image = Image.Text("password", 0.878, 0.871, 0.957);
        label.sprite = Sprite(label.image);
        label.sprite.SetX(screen.half.w - label.image.GetWidth() / 2);
        label.sprite.SetY(screen.half.h + 8);
        prompt_done = 1;
    }

    totalWidth = bulletCount * bullet.image.GetWidth();
    startPos = screen.half.w - totalWidth / 2;
    bullets = null;
    for (i = 0; i < bulletCount; i++) {
        bullets[i].sprite = Sprite(bullet.image);
        bullets[i].sprite.SetX(startPos + i * bullet.image.GetWidth());
        bullets[i].sprite.SetY(screen.half.h + 40);
    }
}

Plymouth.SetDisplayPasswordFunction(DisplayPasswordCallback);
